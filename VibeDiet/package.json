{
  "name": "vibediet",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "AI-Native Nutrition & Adaptive Metabolic Intelligence Platform with 4-Tier Evidence Hierarchy & Atwater Reconciliation",
  "author": "Avi (Primary Architect & Product Engineer)",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "vite build && tsx scripts/build-singlefile.ts && tsx scripts/scan-bundle.ts",
    "start": "tsx server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "scan": "tsx scripts/scan-bundle.ts",
    "sweeper": "tsx scripts/sweeper.ts",
    "swarm": "tsx scripts/swarm-orchestrator.ts",
    "typecheck": "tsc --noEmit",
    "netlify:sync": "tsx scripts/sync-netlify-drop.ts",
    "netlify:drop": "tsx scripts/sync-netlify-drop.ts --force",
    "netlify:watch": "tsx scripts/sync-netlify-drop.ts --watch"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@netlify/database": "^1.1.0",
    "@supabase/supabase-js": "^2.109.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase": "^11.3.0",
    "firebase-admin": "^13.1.0",
    "firebase-functions": "^6.3.0",
    "helmet": "^8.0.0",
    "lucide-react": "^0.475.0",
    "motion": "^14.14.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.0.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2",
    "vite": "^6.1.0",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
