# VibeDiet Standardized Environment Configuration Template
PORT=3000
NODE_ENV=development

# 1. Cloud Firestore & Persistence
FIREBASE_PROJECT_ID=vibediet-prod-saas
# Optional: Path to service account JSON or raw JSON string for live Firestore write
# FIREBASE_SERVICE_ACCOUNT_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=

# 2. Google Gemini Multimodal 50-Key Swarm Pool
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_KEY_POOL_COUNT=50

# 3. Administrative Access Control
ADMIN_UIDS=admin-local-uid,avi-architect-uid,demo-user-uid

# 4. Nutrition & Barcode Databases
USDA_FDC_API_KEY=DEMO_KEY
OPEN_FOOD_FACTS_USER_AGENT=VibeDietSaaS/3.0 (support@vibediet.app)

# 5. Commercial Payment Shield (Razorpay India UPI + Stripe Global)
RAZORPAY_KEY_ID=rzp_test_VibeDiet99210A
RAZORPAY_WEBHOOK_SECRET=whsec_rzp_vibediet_live_shield
STRIPE_PUBLISHABLE_KEY=pk_test_51VibeDietGlobal881
STRIPE_WEBHOOK_SECRET=whsec_stripe_vibediet_global
