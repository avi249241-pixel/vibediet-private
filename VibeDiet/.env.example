# 1. Admin Console Gate (Generate a cryptographically random 32-char secret)
ADMIN_ACCESS_TOKEN=

# 2. Google Gemini AI (Paste real AIzaSy... keys from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_API_KEYS=

# 3. Supabase Auth (Paste from Supabase -> Project Settings -> API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 4. PostgreSQL Database (Optional locally; Netlify Managed Postgres injects NETLIFY_DATABASE_URL automatically)
DATABASE_URL=

# 5. Food & Barcode Lookup
USDA_FDC_API_KEY=DEMO_KEY
OPEN_FOOD_FACTS_USER_AGENT=VibeDietSaaS/3.0 (support@vibediet.app)

# 6. Payments (Leave blank until real Razorpay/Stripe accounts are connected)
RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
